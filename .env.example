# Node backend
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ecosystem

# Authentication: replace before running outside local development.
JWT_SECRET=change_this_to_a_random_256bit_string
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Supporting services
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8000


OPENAI_API_KEY=sk-...
