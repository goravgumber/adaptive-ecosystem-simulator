NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ecosystem

# JSON Web Token secret (minimum 12 characters)
JWT_SECRET=your-very-secure-secret-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis connection string used for BullMQ, caching, and rate limiting
REDIS_URL=redis://127.0.0.1:6379

# Machine learning microservice URL
ML_SERVICE_URL=http://localhost:8000

# Frontend URL for CORS when running in production
# FRONTEND_URL=https://your-frontend-domain.example.com

# Rate limiting settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
